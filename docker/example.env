# Docker compose environment for immich-telegram-drive.
# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# ── Immich core ──────────────────────────────────────────────
# Host directory for photos/thumbnails/database mounts:
UPLOAD_LOCATION=/srv/immich/library
# Host directory for the Postgres data directory:
DB_DATA_LOCATION=/srv/immich/postgres
# Timezone (IANA identifier):
TZ=Asia/Jakarta
# Image tag: 'main' tracks this repository's CI builds:
IMMICH_VERSION=main
# Postgres connection secret — change to a long random value (A-Za-z0-9 only):
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
# Close public sign-up after the first admin exists (set to false):
IMMICH_ALLOW_SETUP=true

# ── Telegram backend ─────────────────────────────────────────
# From https://my.telegram.org -> API development tools:
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Storage chat id (optional; Saved Messages is always included). Leave empty if unused:
TELEGRAM_CHAT_ID=
# Passphrase used to encrypt files stored in Telegram (choose a long random string):
TELEGRAM_VAULT_KEY=
# Max bytes per uploaded part (Telegram limit ~2GB):
TELEGRAM_MAX_PART_BYTES=2000000000
